<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ReToolbox.Views.PowerPlanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:ReToolbox.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style
            x:Key="AtlasLikeSettingsCardTemplate"
            BasedOn="{StaticResource ConfigurationSettingsCardTemplate}"
            TargetType="controls:SettingsCard">
            <Setter Property="Margin" Value="0,0,36,10" />
            <Setter Property="MinHeight" Value="80" />
            <Setter Property="BorderBrush" Value="#0DFFFFFF" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="CategoryTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Page.Resources>

    <Grid Margin="55,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,24,36,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="电源管理" />

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="Refresh_Click"
                Content="刷新" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <!-- Open hero: matches the layout language used by MemoryPage and DefenderPage. -->
                <Grid Margin="0,8,36,34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Width="78"
                        Height="78"
                        Margin="0,0,22,0"
                        VerticalAlignment="Center"
                        FontSize="54"
                        Foreground="{x:Bind ViewModel.HeroStatusForeground, Mode=OneWay}"
                        Glyph="{x:Bind ViewModel.HeroStatusGlyph, Mode=OneWay}" />

                    <!-- Current power plan remains the primary page state. -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,32,0"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.ActivePlanName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{x:Bind ViewModel.HeroStatusDetail, Mode=OneWay}" />
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{x:Bind ViewModel.HeroStatusForeground, Mode=OneWay}"
                                Glyph="&#xE73E;" />
                        </StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.AdminHint, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Battery uses the same compact metric pattern as MemoryPage. -->
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Spacing="5"
                        Visibility="{x:Bind ViewModel.HasBattery, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="电池健康度" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{x:Bind ViewModel.BatteryHealthText, Mode=OneWay}" />
                        </Grid>
                        <ProgressBar
                            Maximum="100"
                            Value="{x:Bind ViewModel.BatteryHealthPercent, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.ChargeStatusText, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.BatterySummary, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Power plan list -->
                <TextBlock
                    Margin="0,4,36,10"
                    Style="{StaticResource CategoryTitle}"
                    Text="电源计划" />

                <ItemsRepeater Margin="0,0,36,0" ItemsSource="{x:Bind ViewModel.PowerPlans, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:PowerPlan">
                            <controls:SettingsCard
                                Margin="0,0,0,10"
                                Style="{StaticResource AtlasLikeSettingsCardTemplate}"
                                Description="{x:Bind Guid, Mode=OneTime}"
                                Header="{x:Bind Name, Mode=OneTime}">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE7B5;" />
                                </controls:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="#2EA043"
                                        Text="● 当前"
                                        Visibility="{x:Bind IsActive, Mode=OneTime}" />
                                    <Button
                                        Click="ApplyPlan_Click"
                                        Content="应用此计划"
                                        IsEnabled="{x:Bind IsActive, Mode=OneTime, Converter={StaticResource InvertBoolConverter}}"
                                        Tag="{x:Bind Guid, Mode=OneTime}" />
                                    <Button
                                        Click="DeletePlan_Click"
                                        Content="删除"
                                        IsEnabled="{x:Bind IsActive, Mode=OneTime, Converter={StaticResource InvertBoolConverter}}"
                                        Tag="{x:Bind Guid, Mode=OneTime}" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Ultimate performance -->
                <TextBlock
                    Margin="0,12,36,10"
                    Style="{StaticResource CategoryTitle}"
                    Text="卓越性能" />

                <controls:SettingsCard
                    x:Name="UltimateCard"
                    Style="{StaticResource AtlasLikeSettingsCardTemplate}"
                    Description="解锁隐藏的「卓越性能 (Ultimate Performance)」计划，针对工作站极致榨取性能，需管理员权限。"
                    Header="一键添加卓越性能计划">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEA80;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        x:Name="AddUltimateButton"
                        Click="AddUltimate_Click"
                        Content="一键添加"
                        IsEnabled="{x:Bind ViewModel.IsAdmin, Mode=OneWay}" />
                </controls:SettingsCard>

                <!-- Switch on logon -->
                <TextBlock
                    Margin="0,12,36,10"
                    Style="{StaticResource CategoryTitle}"
                    Text="开机自动切换" />

                <controls:SettingsCard
                    Style="{StaticResource AtlasLikeSettingsCardTemplate}"
                    Description="开启后每次登录自动切换到指定电源计划（通过任务计划程序实现，无需常驻后台）。"
                    Header="启用开机自动切换">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE916;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="AutoSwitchToggle"
                        Toggled="AutoSwitchToggle_Toggled"
                        OffContent="关"
                        OnContent="开" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Style="{StaticResource AtlasLikeSettingsCardTemplate}"
                    Description="开机后自动应用此电源计划。"
                    Header="目标电源计划">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE945;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="AutoSwitchPlanCombo"
                        Width="240"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind ViewModel.PowerPlans, Mode=OneWay}"
                        SelectedValuePath="Guid"
                        SelectionChanged="AutoSwitchPlan_SelectionChanged" />
                </controls:SettingsCard>

                <TextBlock
                    Margin="0,0,36,10"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.AutoSwitchStatus, Mode=OneWay}" />

                <ProgressBar
                    x:Name="BusyProgress"
                    Margin="0,6,36,12"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.RowSpan="2"
            MaxWidth="420"
            Margin="0,0,36,24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="False"
            Title="" />
    </Grid>
</Page>
