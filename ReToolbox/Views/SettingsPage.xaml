<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ReToolbox.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid Margin="55,0,36,0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow" />
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1120" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SecondaryColumn.Width" Value="*" />
                        <Setter Target="UpdatePanel.Margin" Value="0,0,8,0" />
                        <Setter Target="NetworkPanel.(Grid.Row)" Value="0" />
                        <Setter Target="NetworkPanel.(Grid.Column)" Value="1" />
                        <Setter Target="NetworkPanel.Margin" Value="8,0,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel
                MaxWidth="1080"
                Margin="0,20,0,28"
                HorizontalAlignment="Stretch"
                Spacing="14">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="管理更新方式、下载网络与应用信息" />
                </StackPanel>

                <Border Padding="18" Style="{StaticResource SettingsSurfaceStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="56"
                            Height="56"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="14">
                            <Image
                                Width="34"
                                Height="34"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="ms-appx:///Assets/Logo/toolbox-icon.ico" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.AppName, Mode=OneWay}" />
                                <Border
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.Version, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Description, Mode=OneWay}" />
                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal" Spacing="7">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE895;" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ProgressBar
                                Margin="0,3,0,0"
                                IsIndeterminate="True"
                                Visibility="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            MinWidth="108"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="立即检查 ReToolbox 更新"
                            Click="CheckForUpdates_Click"
                            Content="检查更新"
                            IsEnabled="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Border>

                <Grid x:Name="SettingsColumns">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SecondaryColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="UpdatePanel" Grid.Row="0" Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="更新策略" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="决定 ReToolbox 何时检查和准备新版本" />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsSurfaceStyle}">
                            <StackPanel>
                                <Grid Padding="16,14" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Width="28"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE895;" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="启动时检查更新" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="应用启动后从 GitHub 官方 API 查询最新正式版本" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="2"
                                        AutomationProperties.Name="启动时检查更新"
                                        MinWidth="0"
                                        IsOn="{x:Bind ViewModel.CheckUpdatesOnStartup, Mode=TwoWay}" />
                                </Grid>
                                <Border Height="1" Margin="16,0" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Grid Padding="16,14" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Width="28"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE896;" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="自动下载更新" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="发现新版本后下载并校验，安装前仍会请求确认" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="2"
                                        AutomationProperties.Name="自动下载更新"
                                        MinWidth="0"
                                        IsEnabled="{x:Bind ViewModel.CheckUpdatesOnStartup, Mode=OneWay}"
                                        IsOn="{x:Bind ViewModel.AutomaticUpdateEnabled, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel
                        x:Name="NetworkPanel"
                        Grid.Row="1"
                        Margin="0,14,0,0"
                        Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="下载网络" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="仅在 GitHub 文件直连失败时使用代理" />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsSurfaceStyle}">
                            <StackPanel>
                                <Grid Padding="16,14" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Width="28"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE774;" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="GitHub 下载代理" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="版本信息始终来自官方 API，代理只处理安装包下载" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="2"
                                        AutomationProperties.Name="启用 GitHub 下载代理"
                                        MinWidth="0"
                                        IsOn="{x:Bind ViewModel.IsGitHubMirrorEnabled, Mode=TwoWay}" />
                                </Grid>
                                <Border Height="1" Margin="16,0" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <StackPanel Padding="16,14" Spacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="优先代理地址" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="选择预设、输入自定义地址，或留空按预设顺序尝试" />
                                    </StackPanel>
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="GitHub 下载代理地址"
                                        IsEditable="True"
                                        IsEnabled="{x:Bind ViewModel.IsGitHubMirrorEnabled, Mode=OneWay}"
                                        ItemsSource="{x:Bind ViewModel.MirrorPresets, Mode=OneWay}"
                                        PlaceholderText="自动选择可用代理"
                                        Text="{x:Bind ViewModel.SelectedMirror, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,2,0,0" Spacing="8">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="关于 ReToolbox" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="项目、平台和安全信息" />
                    </StackPanel>
                    <Border Padding="18" Style="{StaticResource SettingsSurfaceStyle}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource SettingTitleStyle}" Text="为 Windows 重装后的常用配置而设计" />
                                <TextBlock
                                    MaxWidth="680"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="基于 WinUI 3 与 Windows App SDK 构建。高风险操作会显示确认提示，远程工具与自动更新会在执行前进行完整性校验。" />
                                <StackPanel Margin="0,2,0,0" Orientation="Horizontal" Spacing="8">
                                    <HyperlinkButton Content="GitHub 项目" NavigateUri="https://github.com/bileizhen/ReToolbox" />
                                    <HyperlinkButton Content="版本发布" NavigateUri="https://github.com/bileizhen/ReToolbox/releases" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                                <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="当前版本" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.Version, Mode=OneWay}" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Windows x64 · Apache-2.0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="第三方代理仅作为 GitHub 安装包下载的失败回退。版本元数据、文件大小和 SHA-256 摘要仍由 GitHub 官方 Release API 提供。"
                        Severity="Informational"
                        Title="更新安全" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
