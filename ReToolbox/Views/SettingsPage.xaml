<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ReToolbox.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style
            x:Key="AtlasLikeSettingsCardTemplate"
            BasedOn="{StaticResource ConfigurationSettingsCardTemplate}"
            TargetType="controls:SettingsCard">
            <Setter Property="Margin" Value="0,0,36,10" />
            <Setter Property="MinHeight" Value="80" />
            <Setter Property="BorderBrush" Value="#0DFFFFFF" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="CategoryTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="55,0,0,0">
            <TextBlock
                Margin="0,24,0,30"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="设置" />

            <TextBlock Style="{StaticResource CategoryTitle}" Text="应用" />
            <controls:SettingsCard
                Style="{StaticResource AtlasLikeSettingsCardTemplate}"
                Description="启动时检查 GitHub 是否发布了新版本"
                Header="更新检查">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.CheckUpdatesOnStartup, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Style="{StaticResource AtlasLikeSettingsCardTemplate}"
                Description="发现新版本后自动下载并校验，安装前仍会请求确认"
                Header="启用自动更新"
                IsEnabled="{x:Bind ViewModel.CheckUpdatesOnStartup, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE896;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.AutomaticUpdateEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Style="{StaticResource AtlasLikeSettingsCardTemplate}"
                Description="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                Header="立即检查更新">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72C;" />
                </controls:SettingsCard.HeaderIcon>
                <Button
                    Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                    Content="检查更新"
                    IsEnabled="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Style="{StaticResource AtlasLikeSettingsCardTemplate}"
                Description="GitHub 直连失败时尝试第三方代理；启用即表示信任其传输"
                Header="GitHub 镜像加速">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.IsGitHubMirrorEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Style="{StaticResource AtlasLikeSettingsCardTemplate}"
                Description="可从预设选择或输入自定义镜像地址，留空则自动尝试"
                Header="下载镜像"
                IsEnabled="{x:Bind ViewModel.IsGitHubMirrorEnabled, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE896;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox
                    IsEditable="True"
                    ItemsSource="{x:Bind ViewModel.MirrorPresets, Mode=OneWay}"
                    Text="{x:Bind ViewModel.SelectedMirror, Mode=TwoWay}"
                    PlaceholderText="自动（留空则按顺序自动尝试）"
                    MinWidth="280" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Style="{StaticResource AtlasLikeSettingsCardTemplate}"
                Description="ReToolbox - Windows 重装后一键配置工具"
                Header="关于">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>

            <controls:SettingsCard
                Style="{StaticResource AtlasLikeSettingsCardTemplate}"
                Header="版本">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </controls:SettingsCard.HeaderIcon>
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.Version, Mode=OneWay}" />
            </controls:SettingsCard>

            <TextBlock Style="{StaticResource CategoryTitle}" Text="技术信息" />
            <controls:SettingsCard
                Style="{StaticResource AtlasLikeSettingsCardTemplate}"
                Description="基于 WinUI 3 / Windows App SDK 构建"
                Header="技术栈">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE943;" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>

            <controls:SettingsCard
                Style="{StaticResource AtlasLikeSettingsCardTemplate}"
                Description="此工具仅供学习和个人使用"
                Header="免责声明">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7BA;" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
